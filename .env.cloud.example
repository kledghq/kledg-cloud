# Kledg Cloud: the variables of the hosted service, on top of Kledg's own
# (.env.example). Placeholders only: real values live in the host's
# environment settings, never in the repository. See docs/cloud.md.

# Turns the hosted service on (public sign-up, billing, read-only mode,
# operator console). Without it, this repository behaves like Kledg.
KLEDG_CLOUD_MODE="true"

# Tenant isolation in PostgreSQL (docs/rls.md): required for the hosted service.
KLEDG_RLS="enforce"
# KLEDG_DATABASE_URL="postgresql://kledg_app:<password>@<host>/<db>?sslmode=require"
# DATABASE_MIGRATION_URL="postgresql://<owner>:<password>@<host>/<db>?sslmode=require"

# Stripe (secret key of the account, restricted key accepted; webhook signing
# secret of the endpoint https://app.kledg.com/api/billing/webhook).
# Prices are found by lookup key: no price id is configured.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Durations, in days. Defaults follow the published CGV (version 1.0).
# KLEDG_CLOUD_TRIAL_DAYS="30"
# KLEDG_CLOUD_GRACE_DAYS="14"
# KLEDG_CLOUD_RETRIEVAL_DAYS="30"
# KLEDG_CLOUD_DELETION_DAYS="30"
# KLEDG_CLOUD_RENEWAL_NOTICE_DAYS="35"
# KLEDG_CLOUD_UNVERIFIED_DAYS="7"
